{"study_key": "peroneo-motor", "study_label": "Peroneo · motor (extensor digitorum brevis)", "reference": "Buschbacher RM. Peroneal nerve motor conduction to the extensor digitorum brevis. Am J Phys Med Rehabil. 1999;78(6 Suppl):S26-S31.", "montaje": {"Posición": "Supino", "Activo": "Punto medio del extensor digitorum brevis, en el dorso del pie", "Referencia": "Ligeramente distal a la 5.ª articulación metatarsofalángica (cara lateral)", "Tierra": "Dorso del pie", "Estímulo": "Tobillo: cátodo 8 cm proximal al activo, lateral al tendón del tibial anterior (ánodo proximal); bajo la cabeza del peroné; sobre la cabeza del peroné (~10 cm proximal)", "Filtros": "2–3 Hz / 10 kHz · 5 mV/div · barrido 5 ms/div"}, "technique_notes": "242 sujetos. Registro en extensor digitorum brevis. Estímulo en tobillo (cátodo 8 cm proximal al electrodo activo, lateral al tendón del tibial anterior), debajo de la cabeza del peroné y encima de la cabeza del peroné (~10 cm proximal). Se excluyeron sujetos con nervio peroneo accesorio. Latencia de inicio, amplitud pico negativo, duración y área; NCV calculada.", "measures": [{"name": "Latencia de inicio (ms) — todos", "abnormal_side": "alto", "columns": ["Media", "DE", "Media+2DE", "Más corta", "p95", "p97", "Más larga"], "rows": [["4.8", "0.8", "6.4", "3.1", "6.4", "6.5", "6.9"]]}, {"name": "Amplitud (mV) por edad", "abnormal_side": "bajo", "columns": ["Edad (años)", "Media", "DE", "Media−2DE", "Menor", "p3", "p5", "Mayor"], "rows": [["19–39", "6.8", "2.5", "1.8", "1.6", "2.6", "2.9", "13.8"], ["40–79", "5.1", "2.5", "0.1", "0.4", "1.1", "1.3", "11.7"], ["Todos", "5.9", "2.6", "0.7", "0.4", "1.3", "1.9", "13.8"]]}, {"name": "Área (µVs) por edad", "abnormal_side": "bajo", "columns": ["Edad (años)", "Media", "DE", "Media−2DE", "Menor", "p3", "p5", "Mayor"], "rows": [["19–49", "20.2", "8.0", "13.2", "0.7", "6.8", "7.8", "39.3"], ["50–79", "14.9", "7.6", "−0.3", "2.9", "3.6", "4.6", "37.1"], ["Todos", "18.3", "8.2", "1.9", "0.7", "4.3", "5.3", "39.3"]]}, {"name": "Duración (ms) — todos", "abnormal_side": "alto", "columns": ["Media", "DE", "Media+2DE", "Más corta", "p95", "p97", "Más larga"], "rows": [["5.7", "1.0", "7.7", "2.9", "7.4", "7.7", "9.0"]]}, {"name": "Velocidad de conducción nerviosa (m/s) por segmento, talla y edad", "abnormal_side": "bajo", "columns": ["Segmento / talla / edad", "Media", "DE", "Media−2DE", "Más lenta", "p3", "p5", "Más rápida"], "rows": [["Tobillo–cabeza peroné · <170 cm · 19–39", "49", "4", "41", "42", "43", "44", "64"], ["Tobillo–cabeza peroné · <170 cm · 40–79", "47", "5", "37", "38", "39", "40", "65"], ["Tobillo–cabeza peroné · ≥170 cm · 19–39", "46", "4", "38", "37", "37", "39", "56"], ["Tobillo–cabeza peroné · ≥170 cm · 40–79", "44", "4", "36", "33", "36", "37", "56"], ["Tobillo–cabeza peroné · Todos", "47", "4", "39", "33", "38", "39", "65"], ["Debajo a encima de cabeza peroné · Todos", "57", "9", "39", "38", "42", "44", "78"]]}, {"name": "Caída de NCV distal a proximal a través de la cabeza del peroné (% entre paréntesis)", "abnormal_side": "bajo", "columns": ["", "Media", "Media−2DE", "p95", "p97", "p100"], "rows": [["Caída pierna → a través de cabeza peroné", "−10 (−23)", "10", "4 (9)", "6 (12)", "13 (21)"]]}, {"name": "Diferencias lado a lado (dominante vs. no dominante)", "abnormal_side": "alto", "columns": ["Estadístico", "Latencia (ms) (%)", "Amplitud (mV) (%)", "Área (µVs) (%)", "Duración (ms) (%)", "NCV pierna (m/s) (%)", "NCV cabeza peroné (m/s) (%)"], "rows": [["Media", "0", "0.1", "0.7", "0.1", "−1", "0"], ["DE", "0.7", "2.3", "6.9", "0.9", "5", "10"], ["Media+2DE", "1.4", "2.5", "13.1", "1.9", "11", "20"], ["p95", "1.4 (27)", "3.7 (50)", "10.9 (56)", "1.3 (23)", "7 (14)", "15 (24)"], ["p97", "1.6 (35)", "4.2 (61)", "11.9 (58)", "1.3 (27)", "8 (16)", "19 (28)"], ["p100", "2.0 (46)", "5.7 (83)", "16.1 (89)", "4.8 (112)", "31 (39)", "31 (38)"]]}]},
